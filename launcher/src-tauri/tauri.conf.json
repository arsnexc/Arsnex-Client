{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arsex Client",
  "version": "2.11.0",
  "identifier": "dev.arsex.client",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arsex Client",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://textures.minecraft.net https://crafatar.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.minecraftservices.com https://launchermeta.mojang.com https://piston-meta.mojang.com https://arsex.dev",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Arsex",
    "category": "Game",
    "shortDescription": "Monochrome katana Minecraft client",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY",
      "endpoints": [
        "https://arsex.dev/api/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
